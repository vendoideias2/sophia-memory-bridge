# ---------------------------------------------------------------------------
# Sophia memory bridge
# Copy to .env and fill the secrets. Never commit .env.
# ---------------------------------------------------------------------------

APP_NAME=sophia-memory-bridge
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
# Do not log message bodies in production.
LOG_MESSAGE_BODIES=false
DATABASE_PATH=/data/memory.db

# Auth for this service
BRIDGE_API_KEY=change-me-bridge
ADMIN_API_KEY=change-me-admin
# Optional shared secret for the WAHA webhook. Use a long random value.
WEBHOOK_SECRET=change-me-webhook

# Hermes API server (internal Coolify network)
HERMES_BASE_URL=http://hermes:8642
# The current self-chat listener uses the fabiano profile.
# Use "default" for the Sophia orchestrator profile.
HERMES_PROFILE=fabiano
HERMES_API_KEY=change-me-hermes-api-key
HERMES_MODEL=hermes-agent
# chat = send the sliding window explicitly (recommended, predictable)
# responses = server-side chained conversations (named conversation)
HERMES_MODE=chat
HERMES_TIMEOUT_SECONDS=180

# Short-term memory
CONTEXT_TTL_MINUTES=360
WINDOW_MESSAGES=20
MAX_CONTEXT_CHARS=24000
MAX_STORED_MESSAGES=200

# Rolling summary (OpenAI-compatible endpoint)
SUMMARY_ENABLED=true
SUMMARY_BASE_URL=https://free.vendoideias.com/v1
SUMMARY_API_KEY=change-me-summary-key
SUMMARY_MODEL=auto
SUMMARY_MAX_WORDS=120
SUMMARY_TIMEOUT_SECONDS=30

# WAHA
WAHA_BASE_URL=https://waha.vendoideias.com
WAHA_API_KEY=change-me-waha-key
WAHA_SESSION=FABIANO
WAHA_TIMEOUT_SECONDS=30
MAX_MESSAGE_CHARS=3500

# Behaviour
ALLOW_GROUPS=false
ALLOW_SELF_CHAT=true
# The self-chat number used by the current Sophia listener.
SELF_CHAT_IDS=5517999999999@c.us
ECHO_WINDOW_SECONDS=120
PROCESS_MEDIA=false
DEDUPE_TTL_HOURS=24

# Optional: override the system prompt. Leave unset for the built-in one.
# SYSTEM_PROMPT=
